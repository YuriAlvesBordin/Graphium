{
  "name": "graphium",
  "version": "2.0.0",
  "description": "Remastered high-performance WebGL2 graph visualization library with silk-smooth force physics, curved edges, node images and a fluent API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "demo": "npx --yes serve .",
    "check:api": "node scripts/check-api.mjs"
  },
  "keywords": [
    "graph",
    "visualization",
    "webgl2",
    "force-directed",
    "network",
    "physics",
    "typescript"
  ],
  "author": "Yuri",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
